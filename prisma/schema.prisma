// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                        String                    @id @default(uuid())
  name                      String
  code                      String                    @unique
  subdomain                 String                    @unique
  contact_email             String
  country_code              String
  kvk                       String?
  legal_name                String?
  address                   String?
  city                      String?
  logo_url                  String?
  number_of_employees       Int?
  phone                     String?
  website                   String?
  terms_accepted            Boolean                   @default(false)
  is_active                 Boolean                   @default(false)

  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt

  billing_invoice           BillingInvoice[]
  debtors                   Debtor[]
  bailiffs                  Bailiff[]
  verdicts                  Verdict[]
  chat_rooms                ChatRoom[]
  invitations               TenantInvitation[]
  employees                 Employee[]
  agreements                Agreement[]
  memberships               Membership[]
  payments                  Payment[]
  financial_report_requests FinancialReportRequest[]
  blockades                 Blockade[]

  subscription              Subscription?

  contracts                 Contract[]
  debt_claims               DebtClaim[]
  lawyers                   Lawyer[]
  block_checks              BlockCheck[]

  @@map("tenant")
}

model DebtClaim {
  id                       String                     @id @default(cuid())

  tenantId                 String
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])

  debtorId                 String
  debtor                   Debtor                    @relation(fields: [debtorId], references: [id])

  reference                String?
  description              String?

  principalAmount          Decimal                    @db.Decimal(18, 2)

  currency                 String                     @default("USD")

  origin                   DebtClaimOrigin
  status                   DebtClaimStatus

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  closedAt                 DateTime?


  contract                 Contract?

  administrativeCollection AdministrativeCollection?
  collectiveCollection     CollectiveCollection?
  legalProcess             LegalProcess?

  blockade                 Blockade?                 @relation("ClaimOrigin")

  agreements               Agreement[]

  documents                ClaimDocument[]
  charges                  ClaimCharge[]
  timeline                 ClaimTimeline[]
  services                 ClaimService[]
  chatRooms                ChatRoom[]
  obligations              DebtClaimObligation[]

  @@map("debt_claim")
}

model DebtClaimObligation {
  id             String            @id @default(cuid())

  debtClaimId    String
  debtClaim      DebtClaim        @relation(fields: [debtClaimId], references: [id])

  type           ObligationType
  beneficiary    BeneficiaryType

  originalAmount Decimal
  paidAmount     Decimal           @default(0)
  balanceAmount  Decimal

  status         ObligationStatus

  dueDate        DateTime?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  payments       Payment[]

  @@map("debt_claim_obligation")
  @@index([debtClaimId])
}

model Blockade {
  id                String              @id @default(cuid())

  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])

  debtorId          String
  debtor            Debtor             @relation(fields: [debtorId], references: [id])

  originDebtClaimId String?             @unique
  originDebtClaim   DebtClaim?         @relation("ClaimOrigin",fields:[originDebtClaimId],references:[id] )

  reason            BlockadeReason

  registeredAt      DateTime            @default(now())
  releasedAt        DateTime?

  status            BlockadeStatus

  paymentId         String?
  payment           Payment?           @relation(fields: [paymentId], references: [id])

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  documents         BlockadeDocument[]

  @@index([tenantId])
  @@index([debtorId])
  @@map("blockade")
}

model BlockCheck {
  id            String    @id @default(cuid())

  tenantId      String
  tenant        Tenant   @relation(fields:[tenantId], references:[id])

  personId      String?
  person        Person?  @relation(fields:[personId], references:[id])

  debtorId      String?
  debtor        Debtor?  @relation(fields:[debtorId], references:[id])

  blockadeFound Boolean

  price         Decimal   @db.Decimal(18,2)

  checkedAt     DateTime  @default(now())
  checkedById   String?
  checkedBy     User?    @relation(fields:[checkedById], references:[id])

  @@map("block_check")
}

model AdministrativeCollection {
  id          String                          @id @default(cuid())

  debtClaimId String                          @unique
  debtClaim   DebtClaim                      @relation(fields:[debtClaimId], references:[id])

  status      AdministrativeCollectionStatus

  startedAt   DateTime
  finishedAt  DateTime?

  steps       AdministrativeCollectionStep[]

  @@map("administrative_collection")
}

model AdministrativeCollectionStep {
  id           String                    @id @default(cuid())

  collectionId String
  collection   AdministrativeCollection @relation(fields:[collectionId], references:[id])

  step         AOPStep

  deadline     DateTime?

  sentAt       DateTime?

  completedAt  DateTime?

  status       WorkflowStatus

  @@map("administrative_collection_step")
}

model CollectiveCollection {
  id            String                      @id @default(cuid())

  debtClaimId   String                      @unique
  debtClaim     DebtClaim                  @relation(fields:[debtClaimId], references:[id])

  status        CollectiveCollectionStatus

  startedAt     DateTime
  finishedAt    DateTime?

  negotiations  COLNegotiation[]
  notifications COLNotification[]

  @@map("collective_collection")
}

model COLNegotiation {
  id             String                @id @default(cuid())

  collectionId   String
  collection     CollectiveCollection @relation(fields:[collectionId], references:[id])

  proposalAmount Decimal               @db.Decimal(18,2)
  acceptedAmount Decimal?              @db.Decimal(18,2)

  status         NegotiationStatus

  notes          String?

  @@map("col_negotiation")
}

model COLNotification {
  id            String                 @id @default(cuid())

  collectionId  String
  collection    CollectiveCollection  @relation(fields:[collectionId], references:[id])

  recipientType NotificationRecipient

  recipientName String?

  channel       NotificationChannel

  sentAt        DateTime?

  status        NotificationStatus

  @@map("col_notification")
}

model LegalProcess {
  id          String              @id @default(cuid())

  debtClaimId String              @unique
  debtClaim   DebtClaim          @relation(fields:[debtClaimId], references:[id])

  lawyerId    String?
  lawyer      Lawyer?            @relation(fields:[lawyerId], references:[id])

  bailiffId   String?
  bailiff     Bailiff?           @relation(fields:[bailiffId], references:[id])

  status      LegalProcessStatus

  startedAt   DateTime
  closedAt    DateTime?

  verdicts    Verdict[]

  @@map("legal_process")
}

model ClaimService {
  id           String          @id @default(cuid())

  debtClaimId  String
  debtClaim    DebtClaim      @relation(fields:[debtClaimId], references:[id])

  service      ServiceType
  status       WorkflowStatus

  startedAt    DateTime
  finishedAt   DateTime?

  startedById  String?
  finishedById String?

  @@map("claim_service")
}

model ClaimTimeline {

  id          String         @id @default(cuid())

  debtClaimId String
  debtClaim   DebtClaim     @relation(fields:[debtClaimId], references:[id])

  event       TimelineEvent
  description String?
  metadata    Json?

  createdAt   DateTime       @default(now())

  @@map("claim_timeline")
}

model ClaimCharge {
  id          String        @id @default(cuid())

  debtClaimId String
  debtClaim   DebtClaim    @relation(fields:[debtClaimId], references:[id])

  service     ServiceType
  concept     String

  amount      Decimal       @db.Decimal(18,2)
  percentage  Decimal?      @db.Decimal(5,2)

  status      ChargeStatus

  @@map("claim_charge")
}

model ClaimDocument {
  id           String       @id @default(cuid())

  debtClaimId  String
  debtClaim    DebtClaim   @relation(fields:[debtClaimId], references:[id])

  service      ServiceType

  fileId       String

  uploadedById String?
  uploadedAt   DateTime     @default(now())

  @@map("claim_document")
}

// ******************************* ENUMS *******************************

enum ObligationType {
  PRINCIPAL_DEBT
  COLLECTION
  INTEREST
  LEGAL_COST
}

enum BeneficiaryType {
  PARTICIPANT
  CFSB
}

enum ObligationStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ChargeStatus {
  PENDING     // El cargo fue generado pero aún no es exigible o facturable.
  INVOICED    // El cargo ya fue facturado al cliente.
  PAID        // El cargo fue pagado.
  WAIVED      // El cargo fue condonado o exonerado.
  CANCELLED   // El cargo fue anulado antes de ser cobrado.
}

enum TimelineEvent {
  // =========================
  // GENERAL
  // =========================
  CLAIM_CREATED
  CLAIM_UPDATED
  CLAIM_CLOSED
  CLAIM_CANCELLED

  // =========================
  // BLC
  // =========================
  BLOCK_CHECK_PERFORMED

  // =========================
  // FAR
  // =========================
  FAR_REGISTERED
  FAR_COMPLETED

  // =========================
  // AOP
  // =========================
  AOP_STARTED
  AOP_STEP_COMPLETED
  AOP_COMPLETED

  // =========================
  // BLK
  // =========================
  BLOCKADE_REGISTERED
  BLOCKADE_RELEASED

  // =========================
  // COL
  // =========================
  COL_STARTED
  COL_NEGOTIATION_CREATED
  COL_NEGOTIATION_ACCEPTED
  COL_NEGOTIATION_REJECTED
  COL_COMPLETED

  // =========================
  // PAYMENTS
  // =========================
  PAYMENT_REGISTERED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED

  // =========================
  // AGREEMENTS
  // =========================
  AGREEMENT_CREATED
  AGREEMENT_SIGNED
  AGREEMENT_BREACHED
  AGREEMENT_COMPLETED

  // =========================
  // GOP
  // =========================
  GOP_STARTED
  LAWYER_ASSIGNED
  BAILIFF_ASSIGNED
  VERDICT_REGISTERED
  GOP_COMPLETED

  // =========================
  // DOCUMENTS
  // =========================
  DOCUMENT_UPLOADED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED

  // =========================
  // NOTIFICATIONS
  // =========================
  NOTIFICATION_SENT
  NOTIFICATION_DELIVERED
  NOTIFICATION_FAILED

  // =========================
  // SYSTEM
  // =========================
  STATUS_CHANGED
  SERVICE_STARTED
  SERVICE_COMPLETED
}

enum LegalProcessStatus {
  DRAFT               // El proceso fue creado pero aún no ha sido iniciado por el abogado o alguacil.
  ACTIVE              // El proceso judicial está en curso.
  ON_HOLD             // Suspendido temporalmente (esperando audiencia, documentación, resolución, etc.).
  COMPLETED           // El proceso terminó. El resultado se consulta en LegalProcessResult.
  CANCELLED           // El cliente canceló el proceso antes de finalizar.
}

enum LawyerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum NotificationStatus {
  DRAFT               // La notificación fue creada pero aún no está lista para enviarse.
  PENDING             // Está lista para ser enviada cuando el sistema procese la cola.
  SCHEDULED           // Tiene una fecha/hora programada para su envío.
  SENT                // Fue enviada correctamente al proveedor (correo, SMS, WhatsApp, etc.).
  DELIVERED           // Existe confirmación de entrega al destinatario (si el canal lo soporta).
  FAILED              // El envío falló (dirección inválida, error del proveedor, etc.).
  CANCELLED           // Se canceló antes de enviarse.
}

enum CollectiveCollectionStatus {
  ACTIVE             // El proceso COL está siendo gestionado activamente. Se están realizando contactos, negociaciones o seguimiento.
  ON_HOLD            // El proceso está temporalmente suspendido (esperando documentación, respuesta del deudor, decisión del acreedor, etc.).
  COMPLETED          // El servicio COL finalizó correctamente. El resultado se determina con CollectiveCollectionResult.
  CANCELLED          // El cliente decidió cancelar el servicio antes de finalizar.
}

enum AdministrativeCollectionStatus {
  DRAFT              // Creado pero aún no iniciado
  ACTIVE             // El proceso administrativo está en ejecución
  WAITING_RESPONSE   // Esperando respuesta del deudor
  PAID               // La deuda fue pagada durante AOP
  DEFAULTED          // Se declaró el incumplimiento
  BLOCKADE_CREATED   // Se registró el BLK correctamente
  CANCELLED          // Cancelado por el acreedor
  CLOSED             // Finalizado
}

enum ServiceType {
  FAR
  AOP
  BLK
  BLC
  COL
  GOP
}

enum DebtClaimOrigin {
  FAR
  MANUAL
  IMPORT
  API
}

enum DebtClaimStatus {
  OPEN
  IN_PROGRESS
  SETTLED
  CLOSED
  CANCELLED
}

enum BlockadeStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum AOPStep {
  REMINDER
  FINAL_NOTICE
  DEFAULT_NOTICE
  BLK_NOTIFICATION
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationRecipient {
  DEBTOR
  EMPLOYER
  MEMBER
  CLIENT
}

enum NotificationChannel {
  EMAIL
  SMS
  LETTER
  WHATSAPP
}

enum NegotiationStatus {
  OPEN
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @db.VarChar(80) @unique
  password_hash         String?               @db.VarChar(120)
  fullname              String?               @db.VarChar(80)
  phone                 String?               @db.VarChar(25)
  is_active             Boolean               @default(true)

  last_active_tenant_id String?
  memberships           Membership[]

  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  debtors               Debtor[]
  bailiffs              Bailiff[]
  messages              ChatMessage[]
  password_reset_tokens PasswordResetToken[]
  block_checks          BlockCheck[]

  @@map("user")
}

model PasswordResetToken {
  id         String     @id @default(cuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String     @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime   @default(now())


  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_token")
}

model Membership {
  id         String            @id @default(uuid())

  user_id    String
  user       User             @relation(fields: [user_id], references: [id])

  tenant_id  String
  tenant     Tenant           @relation(fields: [tenant_id], references: [id])

  status     MembershipStatus  @default(PENDING)

  roles      MembershipRole[]

  created_at DateTime          @default(now())

  @@unique([user_id, tenant_id]) // evita duplicados

  @@map("membership")
}

model MembershipRole {
  id            String      @id @default(uuid())

  membership_id String

  role          UserRole

  membership    Membership @relation(fields: [membership_id], references: [id])

  @@unique([membership_id, role])
  @@map("membership_role")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
}

model TenantInvitation {
  id         String     @id @default(uuid())
  tenant_id  String
  email      String
  fullname   String?
  token      String     @unique
  role       UserRole   @default(DEBTOR)
  debtor_id  String?
  created_at DateTime   @default(now())
  expires_at DateTime
  used       Boolean    @default(false)
  used_at    DateTime?
  tenant     Tenant    @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, email])
  @@index([tenant_id, token])
  @@map("tenant_invitation")
}

model Person {
  id                        String                    @id @default(uuid())
  person_type               PersonType

  identification_type       IdentificationType
  identification            String                    @unique

  first_name                String?
  last_name                 String?
  business_name             String?

  email                     String?                   @unique
  phone                     String?
  address                   String?
  birth_date                DateTime?
  birth_place               String?

  has_blockade              Boolean                   @default(false)

  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt

  debtors                   Debtor[]
  financial_report_requests FinancialReportRequest[]
  block_checks              BlockCheck[]

  // bailiff             Bailiff?
  // employee            Employee?

  @@map("person")
}

model Parameter {
  id                             String    @id @default(uuid())

  //                             =========================================
  //                             COLLECTION
  //                             =========================================
  collection_fee_rate            Float     @default(0)
  collection_fee_minimum_amount  Float     @default(0)

  //                             =========================================
  // ABB / TAXES
  //                             =========================================
  abb_rate                       Float     @default(0)

  //                             =========================================
  // AANMANING TERMS
  //                             =========================================
  company_aanmaning_term_days    Int       @default(0)
  consumer_aanmaning_term_days   Int       @default(0)

  //                             =========================================
  // SOMMATIE TERMS
  //                             =========================================
  company_sommatie_term_days     Int       @default(0)
  consumer_sommatie_term_days    Int       @default(0)

  //                             =========================================
  // MEMBERSHIP / PFC
  //                             =========================================
  small_company_price            Float     @default(0)
  small_company_pfc_contribution Float     @default(0)

  large_company_price            Float     @default(0)
  large_company_pfc_contribution Float     @default(0)

  //                             =========================================
  //                             PENALTIES
  //                             =========================================
  company_aanmaning_penalty      Float     @default(0)
  natural_aanmaning_penalty      Float     @default(0)

  company_sommatie_penalty       Float     @default(0)
  natural_sommatie_penalty       Float     @default(0)

  //                             =========================================
  //                             REACTION
  //                             =========================================
  company_reaction_limit_days    Int       @default(0)

  company_no_reaction_penalty    Float     @default(0)
  natural_no_reaction_penalty    Float     @default(0)

  //                             =========================================
  // PAYMENT AGREEMENTS
  //                             =========================================
  company_payment_agreement_fee  Float     @default(0)
  natural_payment_agreement_fee  Float     @default(0)

  //                             =========================================
  //                             INVOICES
  //                             =========================================
  invoice_number_length          Int       @default(8)
  invoice_prefix                 String    @default("")
  invoice_sequence               Int       @default(0)

  //                             =========================================
  //                             BANKS
  //                             =========================================
  bank_account                   String    @default("")
  bank_name                      String    @default("")

  //                             =========================================
  //                             COSTS
  //                             =========================================
  digital_file_costs             Float     @default(0)
  extra_administrative_costs     Float     @default(0)
  report_financial_pricing       Float     @default(0)
  blok_check_pricing             Float     @default(30)

  //                             =========================================
  //                             SYSTEM
  //                             =========================================
  currency_code                  String    @default("USD")
  timezone                       String    @default("America/Kralendijk")

  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  @@map("parameter")
}

model SettingCategory {
  id          String     @id @default(cuid())

  key         String     @unique
  name        String

  description String?
  icon        String?

  sortOrder   Int        @default(0)

  isActive    Boolean    @default(true)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  settings    Setting[]

  @@map("setting_categories")
}

model Setting {
  id          String           @id @default(cuid())

  tenantId    String?

  categoryId  String
  category    SettingCategory @relation(fields: [categoryId], references: [id])

  name        String
  description String?

  key         String
  value       String

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, key])

  @@index([tenantId])
  @@index([categoryId])

  @@map("settings")
}

model Verdict {
  id                  String                    @id @default(uuid())

  tenant_id           String
  tenant              Tenant                   @relation(fields: [tenant_id], references: [id])

  debtor_id           String
  debtor              Debtor                   @relation(fields: [debtor_id], references: [id])

  legal_process_id    String
  legal_process       LegalProcess             @relation(fields: [legal_process_id], references: [id])

  invoice_number      String                    @db.VarChar(100)
  creditor_name       String                    @db.VarChar(100)

  registration_number String                    @db.VarChar(100)
  sentence_amount     Float
  sentence_date       DateTime

  procesal_cost       Float?                    @default(0)
  notes               String?
  bailiff_id          String
  bailiff             Bailiff?                 @relation("BailiffToVerdict", fields: [bailiff_id], references: [id])

  status              VerdictStatus             @default(DRAFT)

  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  attachments         VerdictAttachment[]
  bailiff_services    VerdictBailiffServices[]
  verdict_embargo     VerdictEmbargo[]
  verdict_interest    VerdictInterest[]

  @@map("verdict")
}

model VerdictInterest {
  id                  String                    @id @default(uuid())
  interest_type       String
  base_amount         Float
  calculated_interest Float?
  calculation_start   DateTime
  calculation_end     DateTime
  total_interest      Float
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt
  verdict_id          String?
  verdict             Verdict?                 @relation(fields: [verdict_id], references: [id])
  details             VerdictInterestDetails[]

  @@map("verdict_interest")
}

model VerdictInterestDetails {
  id                  String           @id @default(uuid())
  period              String
  period_start        DateTime
  period_end          DateTime
  days                Int
  annual_rate         Float
  proportional_rate   Float
  base_amount         Float
  interest            Float
  total               Float
  verdict_interest_id String
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  verdict_interest    VerdictInterest @relation(fields: [verdict_interest_id], references: [id])

  @@map("verdict_interest_details")
}

model VerdictEmbargo {
  id              String    @id @default(uuid())
  verdict_id      String
  company_name    String
  company_phone   String
  company_email   String
  company_address String
  embargo_type    String
  embargo_date    DateTime
  embargo_amount  Float
  total_amount    Float
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  verdict         Verdict  @relation(fields: [verdict_id], references: [id])

  @@map("verdict_embargo")
}

model VerdictBailiffServices {
  id                     String    @id @default(uuid())
  verdict_id             String
  service_invoice_number String
  service_type           String
  service_cost           Float
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  verdict                Verdict  @relation(fields: [verdict_id], references: [id])

  @@map("verdict_bailiff_services")
}

model VerdictAttachment {
  id         String    @id @default(uuid())
  verdict_id String
  file_path  String
  file_size  BigInt
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  file_name  String
  verdict    Verdict  @relation(fields: [verdict_id], references: [id])

  @@map("verdict_attachment")
}

model InterestType {
  id               String               @id @default(uuid())
  name             String
  calculation_type CalculationTypeEnum
  details          InterestDetail[]

  @@map("interest_type")
}

model InterestDetail {
  id               String        @id @default(uuid())
  date             String
  rate             Float
  interest_type_id String
  interest_type    InterestType @relation(fields: [interest_type_id], references: [id])

  @@map("interest_detail")
}

model BillingInvoice {
  id             String                  @id @default(uuid())
  tenant_id      String

  payment_id     String                  @unique
  payment        Payment                @relation(fields: [payment_id], references: [id])

  invoice_number String                  @unique
  amount         Float
  currency       String                  @default("USD")
  issue_date     DateTime
  due_date       DateTime
  description    String?
  status         String                  @default("unpaid")
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt
  tenant         Tenant                 @relation(fields: [tenant_id], references: [id])
  details        BillingInvoiceDetail[]
  payments       BillingPayment[]

  @@map("billing_invoice")
}

model BillingInvoiceDetail {
  id                  String           @id @default(uuid())
  item_description    String
  item_quantity       Int
  item_unit_price     Float
  item_total_price    Float
  item_tax_rate       Float
  item_tax_amount     Float
  item_total_with_tax Float
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  billing_invoice_id  String?
  billing_invoice     BillingInvoice? @relation(fields: [billing_invoice_id], references: [id])

  @@map("billing_invoice_detail")
}

model BillingPayment {
  id                 String           @id @default(uuid())
  payment_date       DateTime
  amount             Float
  payment_method     String
  transaction_id     String?
  status             String
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  billing_invoice_id String?
  billing_invoice    BillingInvoice? @relation(fields: [billing_invoice_id], references: [id])

  @@map("billing_payment")
}


model Debtor {
  id           String          @id @default(uuid())

  tenant_id    String
  tenant       Tenant         @relation(fields: [tenant_id], references: [id])

  person_id    String
  person       Person         @relation(fields: [person_id], references: [id])

  user_id      String?
  user         User?          @relation(fields: [user_id], references: [id])

  email        String
  total_income Float           @default(0)

  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  incomes      DebtorIncome[]
  verdicts     Verdict[]
  agreements   Agreement[]
  blockades    Blockade[]
  block_checks BlockCheck[]
  debt_claims  DebtClaim[]

  @@map("debtor")
}

model DebtorIncome {
  id         String    @id @default(uuid())
  debtor_id  String
  amount     Float
  source     String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  debtor     Debtor   @relation(fields: [debtor_id], references: [id])

  @@map("debtor_incomes")
}

model Bailiff {
  id             String          @id @default(uuid())

  tenant_id      String
  tenant         Tenant         @relation(fields: [tenant_id], references: [id])

  fullname       String
  email          String          @unique
  phone          String?

  user_id        String?
  user           User?          @relation(fields: [user_id], references: [id])

  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  verdicts       Verdict[]      @relation("BailiffToVerdict")

  legalProcesses LegalProcess[]

  @@map("bailiff")
}

model Lawyer {
  id                                                                        String          @id @default(cuid())

  tenantId                                                                  String?
  tenant                                                                    Tenant?        @relation(fields: [tenantId], references: [id])

  firstName                                                                 String
  lastName                                                                  String

  companyName                                                               String?

  identification                                                            String?
  barRegistration   String? // Número de colegiatura o registro profesional

  email                                                                     String?
  phone                                                                     String?
  mobile                                                                    String?

  address                                                                   String?
  city                                                                      String?
  country                                                                   String?

  status                                                                    LawyerStatus

  notes                                                                     String?

  createdAt                                                                 DateTime        @default(now())
  updatedAt                                                                 DateTime        @updatedAt
  deletedAt                                                                 DateTime?


  legalProcesses                                                            LegalProcess[]

  @@index([tenantId])
  @@index([status])

  @@map("lawyer")
}

model Employee {
  id             String    @id @default(uuid())
  identification String
  first_name     String
  last_name      String
  email          String
  address        String?
  phone          String?
  tenant_id      String
  tenant         Tenant   @relation(fields: [tenant_id], references: [id])
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@unique([identification])
  @@map("employee")
}

model ChatRoom {
  id          String         @id @default(cuid())
  tenant_id   String
  tenant      Tenant        @relation(fields: [tenant_id], references: [id])
  debtClaimId String
  debtClaim   DebtClaim     @relation(fields: [debtClaimId], references: [id])
  name        String
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  messages    ChatMessage[]

  @@map("chat_room")
}

model ChatMessage {
  id         String    @id @default(cuid())
  room_id    String
  room       ChatRoom @relation(fields: [room_id], references: [id])

  sender_id  String
  sender     User     @relation(fields: [sender_id], references: [id])
  message    String
  file_url   String?
  file_name  String?

  timestamp  DateTime  @default(now())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@map("chat_message")
}

model Agreement {
  id                 String                  @id @default(cuid())

  debtor_id          String?

  debtClaim_id       String
  debtClaim          DebtClaim              @relation(fields: [debtClaim_id], references: [id])
  total_amount       Decimal                 @db.Decimal(10, 2)
  installment_amount Decimal                 @db.Decimal(10, 2)
  installments_count Int
  start_date         DateTime
  end_date           DateTime
  status             AgreementStatus         @default(PENDING)
  tenant_id          String
  tenant             Tenant                 @relation(fields: [tenant_id], references: [id])
  comment            String?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt

  //                 Relaciones
  debtor             Debtor?                @relation(fields: [debtor_id], references: [id])
  installments       AgreementInstallment[]
  payment            Payment[]

  @@map("agreement")
}

model AgreementInstallment {
  id           String             @id @default(cuid())
  agreement_id String
  number       Int
  due_date     DateTime
  amount       Decimal            @db.Decimal(10, 2)
  status       InstallmentStatus  @default(PENDING)
  payment_id   String?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt

  //           Relaciones
  agreement    Agreement         @relation(fields: [agreement_id], references: [id])
  payment      Payment?          @relation(fields: [payment_id], references: [id])

  @@map("agreement_installment")
}

enum ContractStatus {
  DRAFT
  PENDING_PAYMENT
  REGISTERED
  IN_COLLECTION
  CANCELLED
}

enum ContractPartyRole {
  PARTY_A
  PARTY_B
}

enum ContractType {
  DELIVERY_OF_GOODS
  SERVICES
  RENT
  LOAN
  PAYMENT_ARRANGEMENT
  OTHER
}

model Contract {
  id                 String              @id @default(cuid())

  tenant_id          String
  tenant             Tenant             @relation(fields: [tenant_id], references: [id])

  debtClaim_id       String?             @unique
  debtClaim          DebtClaim?         @relation(fields: [debtClaim_id], references: [id])

  status             ContractStatus      @default(DRAFT)

  contract_type      ContractType

  contract_date      DateTime
  start_date         DateTime
  end_date           DateTime?

  amount             Decimal             @db.Decimal(12,2)

  installment_count  Int?
  installment_amount Decimal?            @db.Decimal(12,2)

  description        String?             @db.Text

  reference_number   String              @unique

  parties            ContractParty[]
  documents          ContractDocument[]
  activation_payment Payment?

  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  @@index([tenant_id])
  @@map("contract")
}

model ContractParty {
  id                  String              @id @default(cuid())

  contract_id         String
  contract            Contract           @relation(fields: [contract_id], references: [id],onDelete: Cascade)

  role                ContractPartyRole

  person_type         PersonType
  identification_type IdentificationType
  identification      String

  fullname            String
  email               String
  phone               String
  birth_date          DateTime?
  birth_place         String?
  address             String?

  created_at          DateTime            @default(now())

  @@index([contract_id])
  @@map("contract_party")
}

model ContractDocument {
  id          String    @id @default(cuid())

  contract_id String
  contract    Contract @relation(fields: [contract_id], references: [id],onDelete: Cascade)

  file_name   String
  file_path   String

  mime_type   String
  file_size   Int

  created_at  DateTime  @default(now())

  @@index([contract_id])
  @@map("contract_document")
}

enum PaymentType {
  SUBSCRIPTION
  CONTRACT_ACTIVATION
  AGREEMENT_INSTALLMENT
  DEBT_PAYMENT
  BLOK_CHECK
  FINANCIAL_REPORT
  COLLECTION
  OTHER
}

model Payment {
  id               String                  @id @default(cuid())

  tenant_id        String
  tenant           Tenant                 @relation(fields: [tenant_id], references: [id])

  obligation_id    String?
  obligation       DebtClaimObligation?   @relation(fields: [obligation_id], references: [id])

  total_amount     Decimal                 @db.Decimal(10, 2)
  status           PaymentStatus           @default(pending)
  paid_at          DateTime?               @db.Date

  // Sentoo / Pasarela
  provider         String?
  provider_ref     String?                 @unique
  provider_payload Json?

  reference_number String?
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt

  payment_url      String?                 @unique

  processing_error String?

  payment_type     PaymentType             @default(OTHER)

  agreement_id     String?
  contract_id      String?                 @unique
  contract         Contract?              @relation(fields: [contract_id], references: [id])

  method           PaymentMethod

  allocations      PaymentAllocation[]
  installments     AgreementInstallment[]
  agreements       Agreement?             @relation(fields: [agreement_id], references: [id])
  blockades        Blockade[]

  billing_invoice  BillingInvoice?

  @@map("payment")
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  reversed
}

enum PaymentSentooStatus {
  success
  pending
  failed
  cancelled
  expired
}

model PaymentAllocation {
  id         String            @id @default(cuid())
  payment_id String
  payment    Payment          @relation(fields: [payment_id], references: [id])
  component  PaymentComponent
  amount     Decimal           @db.Decimal(10, 2)

  @@map("payment_allocation")
}

model FinancialReportRequest {
  id             String         @id @default(cuid())

  tenant_id      String
  tenant         Tenant        @relation(fields: [tenant_id], references: [id])

  // 👤 Relación con persona/deudor
  person_id      String?
  person         Person?       @relation(fields: [person_id], references: [id])

  // 💳 Pago (Sentoo)
  payment_id     String?
  payment_status PaymentStatus  @default(pending)

  amount         Decimal        @db.Decimal(10,2)

  // 🧾 Auditoría
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@index([tenant_id])
  @@index([payment_status])

  @@map("financial_report_request")
}

model Plan {
  id                 String          @id @default(uuid())
  name               String
  description        String?

  monthly_price      Decimal         @db.Decimal(10, 2)
  yearly_price       Decimal         @db.Decimal(10, 2)

  features           Json
  reactivation_price Decimal         @db.Decimal(10, 2)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  is_active          Boolean         @default(true)

  subscription       Subscription[]

  @@map("plan")
}

model Subscription {
  id                 String              @id @default(uuid())
  tenant_id          String              @unique
  tenant             Tenant             @relation(fields: [tenant_id], references: [id])
  plan_id            String
  plan               Plan               @relation(fields: [plan_id], references: [id])

  billing_cycle      BillingCycle

  status             SubscriptionStatus  @default(PENDING)
  activated_at       DateTime?

  current_period_end DateTime
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  @@map("subscription")
}


model BlockadeDocument {
  id           String    @id @default(cuid())

  blockadeId   String

  fileName     String
  originalName String

  mimeType     String

  size         Int

  storageKey   String

  createdAt    DateTime  @default(now())

  blockade     Blockade @relation(fields: [blockadeId],references: [id], onDelete: Cascade)

  @@index([blockadeId])
  @@map("blockade_document")
}

model Entitlement {
  id                                                String    @id @default(uuid())
  userId                                            String
  feature                                           String
  paymentStatus String   // UNPAID | PENDING | PAID
  paymentUrl                                        String?
  updatedAt                                         DateTime  @updatedAt
  createdAt                                         DateTime  @default(now())

  @@index([userId,                                  feature])
  @@map("entitlement")
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentComponent {
  PRINCIPAL
  FINE
  INTEREST
  INSTALLMENT
  OTHER
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum AgreementStatus {
  PENDING
  IN_NEGOTIATION
  COUNTEROFFER
  ACCEPTED
  REJECTED
  CANCELLED
  CLOSED
}

enum CalculationTypeEnum {
  FIXED
  VARIABLE
}

enum VerdictStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}


enum IdentificationType {
  KVK
  CEDULA
  PASSPORT
  RIJBEWIJS
}

enum UserRole {
  PLATFORM_OWNER
  TENANT_ADMIN
  AGENT
  DEBTOR
  BAILIFF
  LAWYER
  BANK
  EMPLOYEE
}

enum PaymentMethod {
  TRANSFER
  CREDIT_CARD
}


enum PersonType {
  INDIVIDUAL
  COMPANY
}

enum InvitationRole {
  DEBTOR
  AGENT
  SHERIFF
}


enum BlockadeReason {
  UNPAID_PAYMENT
}
