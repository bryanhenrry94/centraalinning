  billing_invoice BillingInvoice?

  transfer_verification PaymentTransferVerification?

  lawyer_fee_invoice  LawyerFeeInvoice?
  bailiff_fee_invoice BailiffFeeInvoice?

  case_transfer                    CaseTransfer?
  financial_agreement_registration FinancialAgreement?
  gop_payment_confirmation         GopPaymentConfirmation?
  collective_collection_start      CollectiveCollection?

  @@map("payment")
}

model PaymentTransferVerification {
  id                String                       @id @default(cuid())
  payment_id        String                       @unique
  payment           Payment                      @relation(fields: [payment_id], references: [id])
  receipt_file_path String
  receipt_file_name String
  token             String                       @unique
  token_expires_at  DateTime
  decision          TransferVerificationDecision @default(PENDING)
  decided_at        DateTime?
  decided_by_id     String?
  decided_by        User?                        @relation(fields: [decided_by_id], references: [id])
  balance_after     Decimal?                     @db.Decimal(18, 2)
  rejection_reason  String?
  created_at        DateTime                     @default(now())
  updated_at        DateTime                     @updatedAt

  @@map("payment_transfer_verification")
}

enum TransferVerificationDecision {
