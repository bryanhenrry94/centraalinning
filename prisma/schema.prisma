// Configuración editable por el Superadministrador sin tocar código (punto
// 14 del análisis CFSB): reemplaza al singleton global Parameter. Jerarquía
// de resolución (ver SettingService.resolveValue): override de tenant >
// valor por jurisdicción/isla > valor global. jurisdictionId es lo que
// permite tarifas/plazos/ABB/notificaciones/frecuencia de recordatorios
// distintos por isla sin ningún cambio de código, solo datos.
model Setting {
  id String @id @default(cuid())

  tenantId String?

  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])

  categoryId String
  category   SettingCategory @relation(fields: [categoryId], references: [id])

  name        String
  description String?

  key   String
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, jurisdictionId, key])
  @@index([tenantId])
  @@index([jurisdictionId])
  @@index([categoryId])
  @@map("settings")
}

