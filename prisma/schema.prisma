// Contador seguro para la numeración permanente CFSBP-<ISLA>-000001
// (persona física) / CFSB-<ISLA>-000001 (empresa). Una fila por
// combinación prefix+jurisdicción; PersonService la bloquea con SELECT ...
// FOR UPDATE antes de incrementar, así dos altas concurrentes nunca reciben
// el mismo número.
model PersonIdentitySequence {
  id             String       @id @default(cuid())
  prefix         String
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  lastValue      Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([prefix, jurisdictionId])
  @@map("person_identity_sequence")
}

// Isla/jurisdicción operativa de CFSB — DATO, no enum: los nombres de isla
// nunca deben hardcodearse en el código fuente (punto 13 del análisis
// CFSB). Bonaire es la primera activa; Curaçao y Aruba quedan preparadas
// (isActive = false) en el orden de implementación acordado (ver seed.ts).
// Reúne, por jurisdicción: identidad (isla + jurisdicción legal), zona
// horaria, configuración de ABB, prefijo de numeración, servicios activos
// (JurisdictionService) y las tarifas/plazos locales que hasta ahora vivían
// en el singleton global Parameter — ver ParameterService.getParameterForJurisdiction.
model Jurisdiction {
  id String @id @default(cuid())

  islandCode       String @unique // "BON" | "CUR" | "ARU" (dato, cargado por seed/admin)
  islandName       String
  jurisdictionName String
  countryCode      String

  timezone String

  // Configuración de ABB (impuesto) de esta jurisdicción.
  abbRate Float @default(0)

  // Prefijo de numeración permanente (CFSBP-<prefix>-000001). Normalmente
  // igual a islandCode, pero queda separado por si CFSB pide otro código.
  numberingPrefix String

  isActive     Boolean @default(false)
  rolloutOrder Int     @default(0)

  // Tarifas y plazos locales — mismo dominio que el histórico Parameter
  // global, ahora variable por jurisdicción.
  collectionFeeRate          Float  @default(0)
  collectionFeeMinimumAmount Float  @default(0)
  companyAanmaningTermDays   Int    @default(0)
  consumerAanmaningTermDays  Int    @default(0)
  companySommatieTermDays    Int    @default(0)
  consumerSommatieTermDays   Int    @default(0)
  companyAanmaningPenalty    Float  @default(0)
  naturalAanmaningPenalty    Float  @default(0)
  companySommatiePenalty     Float  @default(0)
  naturalSommatiePenalty     Float  @default(0)
  companyReactionLimitDays   Int    @default(0)
  companyNoReactionPenalty   Float  @default(0)
  naturalNoReactionPenalty   Float  @default(0)
  companyPaymentAgreementFee Float  @default(0)
  naturalPaymentAgreementFee Float  @default(0)
  blokCheckPricing           Float  @default(35)
  digitalFileCosts           Float  @default(0)
  extraAdministrativeCosts   Float  @default(0)
  reportFinancialPricing     Float  @default(0)
  currencyCode               String @default("USD")
  bankName                   String @default("")
  bankAccount                String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants   Tenant[]
  persons   Person[]
  services  JurisdictionService[]
  sequences PersonIdentitySequence[]
  settings  Setting[]

  @@map("jurisdiction")
}

// Qué servicios CFSB (FAR/AOP/BLC/BLK/COP/GOP) están habilitados en cada
// jurisdicción — el rollout no tiene por qué activar los seis servicios al
// mismo tiempo en una isla nueva.
model JurisdictionService {
  id             String       @id @default(cuid())
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  service        ServiceType
  isActive       Boolean      @default(false)

  @@unique([jurisdictionId, service])
  @@map("jurisdiction_service")
}

