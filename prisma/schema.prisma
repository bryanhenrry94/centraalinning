  @@index([contract_id])
  @@map("contract_party")
}

model ContractDocument {
  id String @id @default(cuid())

  contract_id String
  contract    Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)

  file_name String
  file_path String

  mime_type String
  file_size Int

  created_at DateTime @default(now())

  @@index([contract_id])
  @@map("contract_document")
}

