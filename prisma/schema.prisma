model Contract {
  id String @id @default(cuid())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  debtClaim_id String?    @unique
  debtClaim    DebtClaim? @relation(fields: [debtClaim_id], references: [id])

  status ContractStatus @default(DRAFT)

  contract_type ContractType

  contract_date DateTime
  start_date    DateTime
  end_date      DateTime?

  amount Decimal @db.Decimal(12, 2)

  installment_count  Int?
  installment_amount Decimal? @db.Decimal(12, 2)

  description String? @db.Text

  reference_number String @unique

  parties            ContractParty[]
  documents          ContractDocument[]
  activation_payment Payment?

  financial_agreements FinancialAgreement[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@map("contract")
}

model ContractParty {
  id String @id @default(cuid())

  contract_id String
  contract    Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)

