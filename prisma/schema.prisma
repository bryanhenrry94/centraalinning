// Permite que UN pago cubra VARIAS obligaciones a la vez — p.ej. el deudor
// paga un solo monto combinado de "costos CFSB" que administrativamente
// son dos obligaciones separadas (registro del AOP + recargo posterior).
// Ver CollectionService.requestDebtorCollectionFeePayment /
// ObligationService.applyAllocatedPayment.
model PaymentAllocation {
  id            String              @id @default(cuid())
  payment_id    String
  payment       Payment             @relation(fields: [payment_id], references: [id])
  obligation_id String
  obligation    DebtClaimObligation @relation(fields: [obligation_id], references: [id])
  component     PaymentComponent
  amount        Decimal             @db.Decimal(10, 2)

  @@map("payment_allocation")
}

model FinancialReportRequest {
  id String @id @default(cuid())

  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  // 👤 Relación con persona/deudor
  person_id String?
  person    Person? @relation(fields: [person_id], references: [id])

  // 💳 Pago (Sentoo)
  payment_id     String?
  payment_status PaymentStatus @default(pending)

  amount Decimal @db.Decimal(10, 2)

  // 🧾 Auditoría
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@index([payment_status])
  @@map("financial_report_request")
}

model Plan {
  id          String  @id @default(uuid())
  name        String
  description String?

  registration_price Decimal @db.Decimal(10, 2)
  monthly_price      Decimal @db.Decimal(10, 2)
  yearly_price       Decimal @db.Decimal(10, 2)

  // Determina el rol (y por lo tanto los accesos) que recibe la cuenta que
  // se registra con este plan — ver SignupService.register. "features" es
  // solo texto descriptivo para la tarjeta del plan, no se interpreta en código.
  target_role UserRole @default(TENANT_ADMIN)

  features           Json
  reactivation_price Decimal  @db.Decimal(10, 2)
  order              Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  is_active          Boolean  @default(true)

  subscription Subscription[]

  @@map("plan")
}

model Subscription {
