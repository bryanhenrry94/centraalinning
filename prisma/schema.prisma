// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                        String                    @id @default(uuid())
  name                      String
  code                      String                    @unique
  subdomain                 String                    @unique
  contact_email             String
  country_code              String
  kvk                       String?
  legal_name                String?
  address                   String?
  city                      String?
  logo_url                  String?
  number_of_employees       Int?
  phone                     String?
  website                   String?
  terms_accepted            Boolean                   @default(false)
  is_active                 Boolean                   @default(false)

  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt

  billing_invoice           BillingInvoice[]
  collection_cases          CollectionCase[]
  debtors                   Debtor[]
  bailiffs                  Bailiff[]
  verdicts                  Verdict[]
  chat_rooms                ChatRoom[]
  invitations               TenantInvitation[]
  employees                 Employee[]
  agreements                Agreement[]
  debts                     Debt[]
  memberships               Membership[]
  payments                  Payment[]
  financial_report_requests FinancialReportRequest[]
  blockades                 Blockade[]

  subscription              Subscription?

  contracts                 Contract[]

  @@map("tenant")
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @db.VarChar(80) @unique
  password_hash         String?               @db.VarChar(120)
  fullname              String?               @db.VarChar(80)
  phone                 String?               @db.VarChar(25)
  is_active             Boolean               @default(true)

  last_active_tenant_id String?
  memberships           Membership[]

  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  debtors               Debtor[]
  bailiffs              Bailiff[]
  messages              ChatMessage[]
  password_reset_tokens PasswordResetToken[]

  @@map("user")
}

model PasswordResetToken {
  id         String     @id @default(cuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String     @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime   @default(now())


  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_token")
}

model Membership {
  id         String            @id @default(uuid())

  user_id    String
  user       User             @relation(fields: [user_id], references: [id])

  tenant_id  String
  tenant     Tenant           @relation(fields: [tenant_id], references: [id])

  status     MembershipStatus  @default(PENDING)

  roles      MembershipRole[]

  created_at DateTime          @default(now())

  @@unique([user_id, tenant_id]) // evita duplicados

  @@map("membership")
}

model MembershipRole {
  id            String      @id @default(uuid())

  membership_id String

  role          UserRole

  membership    Membership @relation(fields: [membership_id], references: [id])

  @@unique([membership_id, role])
  @@map("membership_role")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
}

model TenantInvitation {
  id         String     @id @default(uuid())
  tenant_id  String
  email      String
  fullname   String?
  token      String     @unique
  role       UserRole   @default(DEBTOR)
  debtor_id  String?
  created_at DateTime   @default(now())
  expires_at DateTime
  used       Boolean    @default(false)
  used_at    DateTime?
  tenant     Tenant    @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, email])
  @@index([tenant_id, token])
  @@map("tenant_invitation")
}

model Person {
  id                        String                    @id @default(uuid())
  person_type               PersonType

  identification_type       IdentificationType
  identification            String                    @unique

  first_name                String?
  last_name                 String?
  business_name             String?

  email                     String?                   @unique
  phone                     String?
  address                   String?
  birth_date                DateTime?
  birth_place               String?

  has_blockade              Boolean                   @default(false)

  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt

  debtors                   Debtor[]
  financial_report_requests FinancialReportRequest[]

  // bailiff             Bailiff?
  // employee            Employee?

  @@map("person")
}

model Parameter {
  id                             String    @id @default(uuid())

  //                             =========================================
  //                             COLLECTION
  //                             =========================================
  collection_fee_rate            Float     @default(0)
  collection_fee_minimum_amount  Float     @default(0)

  //                             =========================================
  // ABB / TAXES
  //                             =========================================
  abb_rate                       Float     @default(0)

  //                             =========================================
  // AANMANING TERMS
  //                             =========================================
  company_aanmaning_term_days    Int       @default(0)
  consumer_aanmaning_term_days   Int       @default(0)

  //                             =========================================
  // SOMMATIE TERMS
  //                             =========================================
  company_sommatie_term_days     Int       @default(0)
  consumer_sommatie_term_days    Int       @default(0)

  //                             =========================================
  // MEMBERSHIP / PFC
  //                             =========================================
  small_company_price            Float     @default(0)
  small_company_pfc_contribution Float     @default(0)

  large_company_price            Float     @default(0)
  large_company_pfc_contribution Float     @default(0)

  //                             =========================================
  //                             PENALTIES
  //                             =========================================
  company_aanmaning_penalty      Float     @default(0)
  natural_aanmaning_penalty      Float     @default(0)

  company_sommatie_penalty       Float     @default(0)
  natural_sommatie_penalty       Float     @default(0)

  //                             =========================================
  //                             REACTION
  //                             =========================================
  company_reaction_limit_days    Int       @default(0)

  company_no_reaction_penalty    Float     @default(0)
  natural_no_reaction_penalty    Float     @default(0)

  //                             =========================================
  // PAYMENT AGREEMENTS
  //                             =========================================
  company_payment_agreement_fee  Float     @default(0)
  natural_payment_agreement_fee  Float     @default(0)

  //                             =========================================
  //                             INVOICES
  //                             =========================================
  invoice_number_length          Int       @default(8)
  invoice_prefix                 String    @default("")
  invoice_sequence               Int       @default(0)

  //                             =========================================
  //                             BANKS
  //                             =========================================
  bank_account                   String    @default("")
  bank_name                      String    @default("")

  //                             =========================================
  //                             COSTS
  //                             =========================================
  digital_file_costs             Float     @default(0)
  extra_administrative_costs     Float     @default(0)
  report_financial_pricing       Float     @default(0)

  //                             =========================================
  //                             SYSTEM
  //                             =========================================
  currency_code                  String    @default("USD")
  timezone                       String    @default("America/Kralendijk")

  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  @@map("parameter")
}

model SettingCategory {
  id          String     @id @default(cuid())

  key         String     @unique
  name        String

  description String?
  icon        String?

  sortOrder   Int        @default(0)

  isActive    Boolean    @default(true)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  settings    Setting[]

  @@map("setting_categories")
}

model Setting {
  id          String           @id @default(cuid())

  tenantId    String?

  categoryId  String
  category    SettingCategory @relation(fields: [categoryId], references: [id])

  name        String
  description String?

  key         String
  value       String

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, key])

  @@index([tenantId])
  @@index([categoryId])

  @@map("settings")
}

model Verdict {
  id                  String                    @id @default(uuid())
  invoice_number      String                    @db.VarChar(100)
  creditor_name       String                    @db.VarChar(100)
  debtor_id           String
  debt_id             String?
  debt                Debt?                    @relation(fields: [debt_id], references: [id])
  registration_number String                    @db.VarChar(100)
  sentence_amount     Float
  sentence_date       DateTime
  status              VerdictStatus             @default(DRAFT)
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt
  procesal_cost       Float?                    @default(0)
  tenant_id           String
  notes               String?
  bailiff_id          String
  bailiff             Bailiff?                 @relation("BailiffToVerdict", fields: [bailiff_id], references: [id])
  debtor              Debtor                   @relation(fields: [debtor_id], references: [id])
  tenant              Tenant                   @relation(fields: [tenant_id], references: [id])
  attachments         VerdictAttachment[]
  bailiff_services    VerdictBailiffServices[]
  verdict_embargo     VerdictEmbargo[]
  verdict_interest    VerdictInterest[]

  @@map("verdict")
}

model VerdictInterest {
  id                  String                    @id @default(uuid())
  interest_type       String
  base_amount         Float
  calculated_interest Float?
  calculation_start   DateTime
  calculation_end     DateTime
  total_interest      Float
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt
  verdict_id          String?
  verdict             Verdict?                 @relation(fields: [verdict_id], references: [id])
  details             VerdictInterestDetails[]

  @@map("verdict_interest")
}

model VerdictInterestDetails {
  id                  String           @id @default(uuid())
  period              String
  period_start        DateTime
  period_end          DateTime
  days                Int
  annual_rate         Float
  proportional_rate   Float
  base_amount         Float
  interest            Float
  total               Float
  verdict_interest_id String
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  verdict_interest    VerdictInterest @relation(fields: [verdict_interest_id], references: [id])

  @@map("verdict_interest_details")
}

model VerdictEmbargo {
  id              String    @id @default(uuid())
  verdict_id      String
  company_name    String
  company_phone   String
  company_email   String
  company_address String
  embargo_type    String
  embargo_date    DateTime
  embargo_amount  Float
  total_amount    Float
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  verdict         Verdict  @relation(fields: [verdict_id], references: [id])

  @@map("verdict_embargo")
}

model VerdictBailiffServices {
  id                     String    @id @default(uuid())
  verdict_id             String
  service_invoice_number String
  service_type           String
  service_cost           Float
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  verdict                Verdict  @relation(fields: [verdict_id], references: [id])

  @@map("verdict_bailiff_services")
}

model VerdictAttachment {
  id         String    @id @default(uuid())
  verdict_id String
  file_path  String
  file_size  BigInt
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  file_name  String
  verdict    Verdict  @relation(fields: [verdict_id], references: [id])

  @@map("verdict_attachment")
}

model InterestType {
  id               String               @id @default(uuid())
  name             String
  calculation_type CalculationTypeEnum
  details          InterestDetail[]

  @@map("interest_type")
}

model InterestDetail {
  id               String        @id @default(uuid())
  date             String
  rate             Float
  interest_type_id String
  interest_type    InterestType @relation(fields: [interest_type_id], references: [id])

  @@map("interest_detail")
}

model BillingInvoice {
  id             String                  @id @default(uuid())
  tenant_id      String

  payment_id     String                  @unique
  payment        Payment                @relation(fields: [payment_id], references: [id])

  invoice_number String                  @unique
  amount         Float
  currency       String                  @default("USD")
  issue_date     DateTime
  due_date       DateTime
  description    String?
  status         String                  @default("unpaid")
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt
  tenant         Tenant                 @relation(fields: [tenant_id], references: [id])
  details        BillingInvoiceDetail[]
  payments       BillingPayment[]

  @@map("billing_invoice")
}

model BillingInvoiceDetail {
  id                  String           @id @default(uuid())
  item_description    String
  item_quantity       Int
  item_unit_price     Float
  item_total_price    Float
  item_tax_rate       Float
  item_tax_amount     Float
  item_total_with_tax Float
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  billing_invoice_id  String?
  billing_invoice     BillingInvoice? @relation(fields: [billing_invoice_id], references: [id])

  @@map("billing_invoice_detail")
}

model BillingPayment {
  id                 String           @id @default(uuid())
  payment_date       DateTime
  amount             Float
  payment_method     String
  transaction_id     String?
  status             String
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  billing_invoice_id String?
  billing_invoice    BillingInvoice? @relation(fields: [billing_invoice_id], references: [id])

  @@map("billing_payment")
}

model Debt {
  id               String            @id @default(cuid())
  debtor_id        String
  tenant_id        String
  source_type      DebtSourceType
  source_id        String
  principal_amount Decimal           @db.Decimal(10, 2)

  status           DebtStatus
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  debtor           Debtor           @relation(fields: [debtor_id], references: [id])
  tenant           Tenant           @relation(fields: [tenant_id], references: [id])
  payments         Payment[]
  agreements       Agreement[]
  fines            DebtFine[]
  collection_cases CollectionCase[]
  verdicts         Verdict[]

  @@map("debt")
}

model DebtFine {
  id                                                                       String     @id @default(cuid())
  debt_id                                                                  String
  debt                                                                     Debt      @relation(fields: [debt_id], references: [id])

  type        FineType // MORA | PENALTY | INTEREST | JUDICIAL_FEE | OTHER
  description                                                              String?

  amount                                                                   Decimal    @db.Decimal(10, 2)
  applied_at                                                               DateTime   @default(now())

  status       FineStatus // ACTIVE | CANCELLED | REVERSED
  cancelled_at                                                             DateTime?

  created_at                                                               DateTime   @default(now())

  @@map("debt_fine")
}

model CollectionCase {
  id                         String                        @id @default(cuid())
  debt_id                    String?
  debt                       Debt?                        @relation(fields: [debt_id], references: [id])
  reference_number           String                        @unique
  document_number            String?
  issue_date                 DateTime
  due_date                   DateTime
  tenant_id                  String
  debtor_id                  String
  amount_original            Decimal                       @db.Decimal(10, 2)
  fee_rate                   Decimal                       @db.Decimal(5, 2)
  fee_amount                 Decimal                       @db.Decimal(10, 2)
  abb_rate                   Decimal                       @db.Decimal(5, 2)
  abb_amount                 Decimal                       @db.Decimal(10, 2)
  total_fined                Decimal                       @default(0) @db.Decimal(10, 2) // total de multas
  total_due                  Decimal                       @default(0) @db.Decimal(10, 2) // total con impuestos y multas
  total_to_receive           Decimal                       @default(0) @db.Decimal(10, 2) // neto después de retención
  total_paid                 Decimal                       @default(0) @db.Decimal(10, 2)
  balance                    Decimal                       @default(0) @db.Decimal(10, 2)
  status                     CollectionCaseStatus          @default(AANMANING)
  created_at                 DateTime                      @default(now())
  updated_at                 DateTime                      @updatedAt
  debtor                     Debtor                       @relation(fields: [debtor_id], references: [id])
  tenant                     Tenant                       @relation(fields: [tenant_id], references: [id])

  chat_rooms                 ChatRoom[]
  collectionCaseNotification CollectionCaseNotification[]
  contract                   Contract?

  @@map("collection_case")
}

model CollectionCaseNotification {
  id                 String            @id @default(cuid())
  collection_case_id String
  type               NotificationType
  title              String
  message            String
  sent_at            DateTime          @default(now())
  read               Boolean           @default(false)
  created_at         DateTime          @default(now())
  collection_case    CollectionCase   @relation(fields: [collection_case_id], references: [id])

  @@map("collection_case_notification")
}

model Debtor {
  id               String            @id @default(uuid())

  tenant_id        String
  tenant           Tenant           @relation(fields: [tenant_id], references: [id])

  person_id        String
  person           Person           @relation(fields: [person_id], references: [id])

  user_id          String?
  user             User?            @relation(fields: [user_id], references: [id])

  email            String
  total_income     Float             @default(0)

  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  collection_cases CollectionCase[]
  incomes          DebtorIncome[]
  verdicts         Verdict[]
  agreements       Agreement[]
  debts            Debt[]
  blockades        Blockade[]

  @@map("debtor")
}

model DebtorIncome {
  id         String    @id @default(uuid())
  debtor_id  String
  amount     Float
  source     String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  debtor     Debtor   @relation(fields: [debtor_id], references: [id])

  @@map("debtor_incomes")
}

model Bailiff {
  id         String     @id @default(uuid())
  fullname   String
  email      String     @unique
  phone      String?
  tenant_id  String
  user_id    String?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  tenant     Tenant    @relation(fields: [tenant_id], references: [id])
  user       User?     @relation(fields: [user_id], references: [id])
  verdicts   Verdict[] @relation("BailiffToVerdict")

  @@map("bailiff")
}

model Employee {
  id             String    @id @default(uuid())
  identification String
  first_name     String
  last_name      String
  email          String
  address        String?
  phone          String?
  tenant_id      String
  tenant         Tenant   @relation(fields: [tenant_id], references: [id])
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@unique([identification])
  @@map("employee")
}

model ChatRoom {
  id                 String          @id @default(cuid())
  tenant_id          String
  tenant             Tenant         @relation(fields: [tenant_id], references: [id])
  collection_case_id String
  collection_case    CollectionCase @relation(fields: [collection_case_id], references: [id])
  name               String
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  messages           ChatMessage[]

  @@map("chat_room")
}

model ChatMessage {
  id         String    @id @default(cuid())
  room_id    String
  room       ChatRoom @relation(fields: [room_id], references: [id])

  sender_id  String
  sender     User     @relation(fields: [sender_id], references: [id])
  message    String
  file_url   String?
  file_name  String?

  timestamp  DateTime  @default(now())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@map("chat_message")
}

model Agreement {
  id                 String                  @id @default(cuid())
  debtor_id          String?
  debt_id            String
  debt               Debt                   @relation(fields: [debt_id], references: [id])
  total_amount       Decimal                 @db.Decimal(10, 2)
  installment_amount Decimal                 @db.Decimal(10, 2)
  installments_count Int
  start_date         DateTime
  end_date           DateTime
  status             AgreementStatus         @default(PENDING)
  tenant_id          String
  tenant             Tenant                 @relation(fields: [tenant_id], references: [id])
  comment            String?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt

  //                 Relaciones
  debtor             Debtor?                @relation(fields: [debtor_id], references: [id])
  installments       AgreementInstallment[]
  payment            Payment[]

  @@map("agreement")
}

model AgreementInstallment {
  id           String             @id @default(cuid())
  agreement_id String
  number       Int
  due_date     DateTime
  amount       Decimal            @db.Decimal(10, 2)
  status       InstallmentStatus  @default(PENDING)
  payment_id   String?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt

  //           Relaciones
  agreement    Agreement         @relation(fields: [agreement_id], references: [id])
  payment      Payment?          @relation(fields: [payment_id], references: [id])

  @@map("agreement_installment")
}

enum ContractStatus {
  DRAFT
  PENDING_PAYMENT
  REGISTERED
  IN_COLLECTION
  CANCELLED
}

enum ContractPartyRole {
  PARTY_A
  PARTY_B
}

enum ContractType {
  DELIVERY_OF_GOODS
  SERVICES
  RENT
  LOAN
  PAYMENT_ARRANGEMENT
  OTHER
}

model Contract {
  id                 String              @id @default(cuid())

  tenant_id          String
  tenant             Tenant             @relation(fields: [tenant_id], references: [id])

  status             ContractStatus      @default(DRAFT)

  contract_type      ContractType

  contract_date      DateTime
  start_date         DateTime
  end_date           DateTime?

  amount             Decimal             @db.Decimal(12,2)

  installment_count  Int?
  installment_amount Decimal?            @db.Decimal(12,2)

  description        String?             @db.Text

  collection_case_id String?             @unique
  collection_case    CollectionCase?    @relation(fields: [collection_case_id], references: [id])

  reference_number   String              @unique

  parties            ContractParty[]
  documents          ContractDocument[]
  activation_payment Payment?

  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  @@index([tenant_id])
  @@map("contract")
}

model ContractParty {
  id                  String              @id @default(cuid())

  contract_id         String
  contract            Contract           @relation(fields: [contract_id], references: [id],onDelete: Cascade)

  role                ContractPartyRole

  person_type         PersonType
  identification_type IdentificationType
  identification      String

  fullname            String
  email               String
  phone               String
  birth_date          DateTime?
  birth_place         String?
  address             String?

  created_at          DateTime            @default(now())

  @@index([contract_id])
  @@map("contract_party")
}

model ContractDocument {
  id          String    @id @default(cuid())

  contract_id String
  contract    Contract @relation(fields: [contract_id], references: [id],onDelete: Cascade)

  file_name   String
  file_path   String

  mime_type   String
  file_size   Int

  created_at  DateTime  @default(now())

  @@index([contract_id])
  @@map("contract_document")
}

enum PaymentType {
  SUBSCRIPTION
  CONTRACT_ACTIVATION
  AGREEMENT_INSTALLMENT
  DEBT_PAYMENT
  BLOK_CHECK
  FINANCIAL_REPORT
  COLLECTION
  OTHER
}

model Payment {
  id               String                  @id @default(cuid())

  tenant_id        String
  tenant           Tenant                 @relation(fields: [tenant_id], references: [id])

  total_amount     Decimal                 @db.Decimal(10, 2)
  status           PaymentStatus           @default(pending)
  paid_at          DateTime?               @db.Date

  // Sentoo / Pasarela
  provider         String?
  provider_ref     String?                 @unique
  provider_payload Json?

  reference_number String?
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt

  payment_url      String?                 @unique

  // campos a borrar
  processing_error String?

  payment_type     PaymentType             @default(OTHER)

  agreement_id     String?
  contract_id      String?                 @unique
  contract         Contract?              @relation(fields: [contract_id], references: [id])

  debt_id          String?
  debt             Debt?                  @relation(fields: [debt_id], references: [id])
  method           PaymentMethod

  allocations      PaymentAllocation[]
  installments     AgreementInstallment[]
  agreements       Agreement?             @relation(fields: [agreement_id], references: [id])

  billing_invoice  BillingInvoice?

  @@map("payment")
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  reversed
}

enum PaymentSentooStatus {
  success
  pending
  failed
  cancelled
  expired
}

model PaymentAllocation {
  id                                                                               String   @id @default(cuid())
  payment_id                                                                       String
  payment                                                                          Payment @relation(fields: [payment_id], references: [id])
  debt_id                                                                          String?
  component  PaymentComponent // PRINCIPAL | FINE | INTEREST | OTHER | INSTALLMENT
  amount                                                                           Decimal  @db.Decimal(10, 2)

  @@map("payment_allocation")
}

model FinancialReportRequest {
  id             String         @id @default(cuid())

  tenant_id      String
  tenant         Tenant        @relation(fields: [tenant_id], references: [id])

  // 👤 Relación con persona/deudor
  person_id      String?
  person         Person?       @relation(fields: [person_id], references: [id])

  // 💳 Pago (Sentoo)
  payment_id     String?
  payment_status PaymentStatus  @default(pending)

  amount         Decimal        @db.Decimal(10,2)

  // 🧾 Auditoría
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@index([tenant_id])
  @@index([payment_status])

  @@map("financial_report_request")
}

model Plan {
  id                 String          @id @default(uuid())
  name               String
  description        String?

  monthly_price      Decimal         @db.Decimal(10, 2)
  yearly_price       Decimal         @db.Decimal(10, 2)

  features           Json
  reactivation_price Decimal         @db.Decimal(10, 2)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  is_active          Boolean         @default(true)

  subscription       Subscription[]

  @@map("plan")
}

model Subscription {
  id                 String              @id @default(uuid())
  tenant_id          String              @unique
  tenant             Tenant             @relation(fields: [tenant_id], references: [id])
  plan_id            String
  plan               Plan               @relation(fields: [plan_id], references: [id])

  billing_cycle      BillingCycle

  status             SubscriptionStatus  @default(PENDING)
  activated_at       DateTime?

  current_period_end DateTime
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  @@map("subscription")
}

model Blockade {
  id               String              @id @default(cuid())

  tenantId         String
  debtorId         String

  reference_number String              @unique

  amount           Decimal             @db.Decimal(12,2)

  reason           BlockadeReason
  status           BlockadeStatus      @default(ACTIVE)

  registeredAt     DateTime            @default(now())

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  debtor           Debtor             @relation(fields: [debtorId], references: [id])

  documents        BlockadeDocument[]

  @@index([tenantId])
  @@index([debtorId])
  @@map("blockade")
}

model BlockadeDocument {
  id           String    @id @default(cuid())

  blockadeId   String

  fileName     String
  originalName String

  mimeType     String

  size         Int

  storageKey   String

  createdAt    DateTime  @default(now())

  blockade     Blockade @relation(fields: [blockadeId],references: [id], onDelete: Cascade)

  @@index([blockadeId])
  @@map("blockade_document")
}

model Entitlement {
  id                                                String    @id @default(uuid())
  userId                                            String
  feature                                           String
  paymentStatus String   // UNPAID | PENDING | PAID
  paymentUrl                                        String?
  updatedAt                                         DateTime  @updatedAt
  createdAt                                         DateTime  @default(now())

  @@index([userId,                                  feature])
  @@map("entitlement")
}

