// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String  @id @default(uuid())
  name                String
  code                String  @unique
  subdomain           String  @unique
  contact_email       String
  country_code        String
  kvk                 String?
  legal_name          String?
  address             String?
  city                String?
  logo_url            String?
  number_of_employees Int?
  phone               String?
  website             String?
  terms_accepted      Boolean @default(false)
  is_active           Boolean @default(false)

  // Jurisdicción/isla operativa de este deelnemer — determina zona horaria,
  // ABB, prefijo de numeración, servicios activos y tarifas/plazos locales
  // (ver Jurisdiction). Nullable por compatibilidad con tenants existentes
  // sin isla asignada todavía; el seed y el onboarding la fijan.
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  billing_invoice           BillingInvoice[]
  debtors                   Debtor[]
  bailiffs                  Bailiff[]
  verdicts                  Verdict[]
  chat_rooms                ChatRoom[]
  invitations               TenantInvitation[]
  employees                 Employee[]
  agreements                Agreement[]
  memberships               Membership[]
  payments                  Payment[]
  financial_report_requests FinancialReportRequest[]
  blockades                 Blockade[]

  subscription Subscription?

  contracts     Contract[]
  debt_claims   DebtClaim[]
  lawyers       Lawyer[]
  block_checks  BlockCheck[]
  bank_accounts BankAccount[]
  notifications Notification[]

  financial_agreements FinancialAgreement[]

  // COP: expedientes donde este tenant fue detectado como empleador de un
  // deudor de OTRO tenant (ver CollectiveCollection.employerTenantId).
  collectiveCollectionsAsEmployer CollectiveCollection[] @relation("CollectiveCollectionEmployerTenant")

  // COP: respuestas de este tenant a preguntas de broadcast de red de OTROS
  // tenants (ver COLNetworkResponse.tenantId).
  colNetworkResponses COLNetworkResponse[] @relation("COLNetworkResponseTenant")

  supportMessages SupportMessage[]

  @@map("tenant")
}

model DebtClaim {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  debtorId String
  debtor   Debtor @relation(fields: [debtorId], references: [id])

  reference         String?
  externalReference String?
  description       String?

  principalAmount Decimal @db.Decimal(18, 2)

  currency String @default("USD")

  origin DebtClaimOrigin
  status DebtClaimStatus

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  contract Contract?

  administrativeCollection AdministrativeCollection?
  collectiveCollection     CollectiveCollection?
  legalProcess             LegalProcess?

  blockade Blockade? @relation("ClaimOrigin")

  agreements Agreement[]

  documents   ClaimDocument[]
  charges     ClaimCharge[]
  timeline    ClaimTimeline[]
  services    ClaimService[]
  chatRooms   ChatRoom[]
  obligations DebtClaimObligation[]

  caseTransfers                 CaseTransfer[]
  originatingFinancialAgreement FinancialAgreement?

  @@map("debt_claim")
}

// FAR (Financiële Afspraken Registreren) — servicio preventivo independiente,
// no es un DebtClaim/reclamo. Si hay incumplimiento, se escala a un DebtClaim
// (AOP) nuevo vía escalatedToDebtClaimId, no por conversión de tipo.
// Ver docs/schema-design-far-overdracht.md
model FinancialAgreement {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  debtorId String
  debtor   Debtor @relation(fields: [debtorId], references: [id])

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])

  reference   String?
  description String? @db.Text

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("USD")

  status FinancialAgreementStatus @default(PENDING_PAYMENT)

  registrationFeePaymentId String?  @unique
  registrationFeePayment   Payment? @relation(fields: [registrationFeePaymentId], references: [id])

  registeredAt DateTime?

  escalatedToDebtClaimId String?    @unique
  escalatedToDebtClaim   DebtClaim? @relation(fields: [escalatedToDebtClaimId], references: [id])
  escalatedAt            DateTime?
  escalationReason       String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([debtorId])
  @@map("financial_agreement")
}

model DebtClaimObligation {
  id String @id @default(cuid())

  debtClaimId String
  debtClaim   DebtClaim @relation(fields: [debtClaimId], references: [id])

  type        ObligationType
  beneficiary BeneficiaryType

  // Quién debe saldar esta obligación — distinto de `beneficiary` (a quién
  // se le debe). El deudor paga tanto su deuda original (beneficiary:
  // PARTICIPANT) como su propia comisión CFSB en un pago separado
  // (beneficiary: CFSB, payer: DEBTOR) — mismo monto que paga el
  // participante (beneficiary: CFSB, payer: PARTICIPANT) al registrar el
  // AOP, pero como dos obligaciones/pagos independientes, sin reembolso
  // entre ellos. Ver CollectionService.createPending.
  payer ObligationPayer @default(DEBTOR)

  originalAmount Decimal
  paidAmount     Decimal @default(0)
  balanceAmount  Decimal

  status ObligationStatus

  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments    Payment[]
  allocations PaymentAllocation[]

  @@index([debtClaimId])
  @@map("debt_claim_obligation")
}

model Blockade {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  debtorId String
  debtor   Debtor @relation(fields: [debtorId], references: [id])

  originDebtClaimId String?    @unique
  originDebtClaim   DebtClaim? @relation("ClaimOrigin", fields: [originDebtClaimId], references: [id])

  reason     BlockadeReason
  reasonNote String?        @db.Text

  registeredAt DateTime  @default(now())
  releasedAt   DateTime?

  status BlockadeStatus

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents BlockadeDocument[]

  @@index([tenantId])
  @@index([debtorId])
  @@map("blockade")
}

model BlockCheck {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  personId String?
  person   Person? @relation(fields: [personId], references: [id])

  debtorId String?
  debtor   Debtor? @relation(fields: [debtorId], references: [id])

  blockadeFound Boolean

  price Decimal @db.Decimal(18, 2)

  checkedAt   DateTime @default(now())
  checkedById String?
  checkedBy   User?    @relation(fields: [checkedById], references: [id])

  @@map("block_check")
}

model AdministrativeCollection {
  id String @id @default(cuid())

  debtClaimId String    @unique
  debtClaim   DebtClaim @relation(fields: [debtClaimId], references: [id])

  status AdministrativeCollectionStatus

  startedAt  DateTime
  finishedAt DateTime?

  steps AdministrativeCollectionStep[]

  @@map("administrative_collection")
}

model AdministrativeCollectionStep {
  id String @id @default(cuid())

  collectionId String
  collection   AdministrativeCollection @relation(fields: [collectionId], references: [id])

  step AOPStep

  deadline DateTime?

  sentAt DateTime?

  completedAt DateTime?

  status WorkflowStatus

  @@map("administrative_collection_step")
}

model CollectiveCollection {
  id String @id @default(cuid())

  debtClaimId String    @unique
  debtClaim   DebtClaim @relation(fields: [debtClaimId], references: [id])

  status CollectiveCollectionStatus

  startedAt  DateTime
  finishedAt DateTime?

  // Comisión CFSB del 5% por iniciar el COP, a cargo del participante que
  // lo inicia. El COP no pasa a ACTIVE hasta que este pago se confirme
  // (ver CollectiveCollectionService.processStartPaymentConfirmed) — mismo
  // patrón que FinancialAgreement.registrationFeePaymentId.
  startFeePaymentId String?  @unique
  startFeePayment   Payment? @relation(fields: [startFeePaymentId], references: [id])

  // Empleador confirmado mediante la respuesta "Sí" de un tenant al
  // broadcast de red (ver COLNetworkQuery/COLNetworkResponse). Nulo hasta
  // que se encuentre coincidencia; una vez seteado, el job de deadlines
  // deja de revisar este caso.
  employerTenantId  String?
  employerTenant    Tenant?   @relation("CollectiveCollectionEmployerTenant", fields: [employerTenantId], references: [id])
  employerMatchedAt DateTime?

  // Plazo corto (default 2 días, configurable vía Setting
  // col_debtor_grace_period_days) durante el cual solo el deudor puede
  // pagar o solicitar un acuerdo de pago directamente. Pasado este plazo,
  // si employerTenantId está seteado, solo ese tenant puede solicitar un
  // acuerdo en nombre del deudor — ver requireDebtorOrEmployerForNegotiation.
  // Misma ventana que usa COLNetworkQuery.responseDeadline.
  debtorGracePeriodDeadline DateTime?

  // Escalado a GOP — mismo patrón aditivo que
  //                          FinancialAgreement.escalatedToDebtClaimId.
  transferredToCaseTransferId String?       @unique
  transferredToCaseTransfer   CaseTransfer? @relation(fields: [transferredToCaseTransferId], references: [id])

  negotiations  COLNegotiation[]
  notifications COLNotification[]
  networkQuery  COLNetworkQuery?

  @@index([status])
  @@index([employerTenantId])
  @@map("collective_collection")
}

model COLNegotiation {
  id String @id @default(cuid())

  collectionId String
  collection   CollectiveCollection @relation(fields: [collectionId], references: [id])

  proposalAmount Decimal  @db.Decimal(18, 2)
  acceptedAmount Decimal? @db.Decimal(18, 2)

  status NegotiationStatus

  notes String?

  // Quién presentó la propuesta: el deudor mismo, o el tenant empleador
  // confirmado actuando en su nombre tras vencer debtorGracePeriodDeadline
  // (ver CollectiveCollectionService.requestPaymentAgreement). Nunca
  // provisto por el cliente — lo determina el guard según el momento y el
  // match de empleador.
  submittedByRole COLNegotiationSubmitter

  submittedByUserId String?
  submittedBy       User?   @relation(fields: [submittedByUserId], references: [id])

  // Snapshot inmutable del tenant empleador al momento de enviar — no se
  // recalcula si employerTenantId cambia después (no debería, pero evita
  // depender de un join en vivo para la auditoría).
  submittedOnBehalfOfEmployerTenantId String?

  @@map("col_negotiation")
}

model COLNotification {
  id String @id @default(cuid())

  collectionId String
  collection   CollectiveCollection @relation(fields: [collectionId], references: [id])

  recipientType NotificationRecipient

  recipientName String?

  channel NotificationChannel

  sentAt DateTime?

  status NotificationStatus

  @@map("col_notification")
}

// "Presión de red": una pregunta Sí/No difundida a todos los tenants
// activos de la red (excepto el dueño del expediente) para ubicar al
// empleador del deudor, sin revelar monto ni acreedor — reemplaza el match
// silencioso por identification exacta que existía antes de esta versión.
model COLNetworkQuery {
  id String @id @default(cuid())

  collectionId String               @unique
  collection   CollectiveCollection @relation(fields: [collectionId], references: [id])

  // Person.personal_number (CFSBP-xxx) + nombre — nunca el monto ni el
  // acreedor original, por requisito de negocio.
  personalNumber String
  displayName    String

  broadcastAt      DateTime
  responseDeadline DateTime

  status COLNetworkQueryStatus @default(OPEN)

  responses COLNetworkResponse[]

  @@map("col_network_query")
}

// Una fila por tenant preguntado. Las respuestas son privadas entre
// participantes — solo el tenant dueño del expediente ve el progreso
// agregado y el match final (ver CollectiveCollectionService).
model COLNetworkResponse {
  id String @id @default(cuid())

  queryId String
  query   COLNetworkQuery @relation(fields: [queryId], references: [id])

  tenantId String
  tenant   Tenant @relation("COLNetworkResponseTenant", fields: [tenantId], references: [id])

  answer      COLNetworkAnswer?
  respondedAt DateTime?

  respondedById String?
  respondedBy   User?   @relation(fields: [respondedById], references: [id])

  @@unique([queryId, tenantId])
  @@index([tenantId, answer])
  @@map("col_network_response")
}

model LegalProcess {
  id String @id @default(cuid())

  debtClaimId String    @unique
  debtClaim   DebtClaim @relation(fields: [debtClaimId], references: [id])

  // El GOP nace siempre a partir de una transferencia aceptada — ver
  // LegalProcessService.registerVerdict / CaseTransfer más abajo.
  caseTransferId String       @unique
  caseTransfer   CaseTransfer @relation(fields: [caseTransferId], references: [id])

  referenceNumber String? @unique

  bailiffId String
  bailiff   Bailiff @relation(fields: [bailiffId], references: [id])

  status LegalProcessStatus

  // "In onderzoek naar executiemogelijkheden" (GOP_INACTIVE): de sentencia
  // blijft geregistreerd en het dossier blijft open — geen embargo mogelijk
  // is nooit op zich een reden om het GOP te sluiten. inactiveFoundAt is de
  // datum waarop de deurwaarder vaststelde dat er geen mogelijkheid was;
  // reviewDate is de eerstvolgende controledatum.
  inactiveReason  GopInactiveReason?
  inactiveNotes   String?            @db.Text
  inactiveFoundAt DateTime?
  reviewDate      DateTime?

  startedAt DateTime
  closedAt  DateTime?

  // Se setea cuando el alguacil paga la comisión CFSB del 5% (BailiffFeeInvoice.status = PAID).
  gopCompletedGateAt DateTime?

  verdicts             Verdict[]
  documents            LegalProcessDocument[]
  agreements           Agreement[]
  lawyerFeeInvoices    LawyerFeeInvoice[]
  bailiffFeeInvoices   BailiffFeeInvoice[]
  paymentConfirmations GopPaymentConfirmation[]

  @@map("legal_process")
}

// Confirmación centralizada de pagos durante el GOP (AT-009 revisado): el
// deudor puede pagar al alguacil o directamente al participante. Quien
// recibe registra + sube comprobante; la OTRA parte confirma o disputa.
// Solo al confirmar se aplica el pago al saldo (ver LegalProcessService).
enum GopPaymentConfirmationStatus {
  REGISTERED // recién creado por quien recibió el pago
  AWAITING_CONFIRMATION // comprobante adjunto, notificado a la otra parte
  CONFIRMED // la otra parte confirmó — el pago ya se aplicó al saldo
  DISPUTED // la otra parte no reconoce el pago (monto/comprobante incorrecto)
  CORRECTED // quien lo registró corrigió el monto/comprobante tras la disputa
}

enum GopPaymentReceiver {
  BAILIFF
  PARTICIPANT
}

model GopPaymentConfirmation {
  id String @id @default(cuid())

  legalProcessId String
  legalProcess   LegalProcess @relation(fields: [legalProcessId], references: [id])

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  status     GopPaymentConfirmationStatus @default(REGISTERED)
  receivedBy GopPaymentReceiver

  recordedById String?
  recordedAt   DateTime @default(now())

  proofStorageKey   String
  proofOriginalName String
  proofMimeType     String
  proofSize         Int

  confirmedById String?
  confirmedAt   DateTime?

  disputeReason String?   @db.Text
  disputedById  String?
  disputedAt    DateTime?

  correctionNote String?   @db.Text
  correctedById  String?
  correctedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([legalProcessId])
  @@map("gop_payment_confirmation")
}

model LawyerFeeInvoice {
  id             String       @id @default(cuid())
  caseTransferId String
  caseTransfer   CaseTransfer @relation(fields: [caseTransferId], references: [id])

  totalAmount   Decimal   @db.Decimal(18, 2) // Honorarios + gastos declarados por el abogado
  invoiceNumber String?
  invoiceDate   DateTime?

  storageKey   String // Factura subida por el abogado
  originalName String
  mimeType     String
  size         Int

  cfsbFeeAmount Decimal @db.Decimal(18, 2) // 5% de totalAmount

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  status         String        @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID
  createdAt      DateTime      @default(now())
  paidAt         DateTime?
  legalProcess   LegalProcess? @relation(fields: [legalProcessId], references: [id])
  legalProcessId String?

  @@map("lawyer_fee_invoice")
}

// Overdracht — fase de transferencia/aceptación por abogado o alguacil,
// separada de LegalProcess (GOP). A propósito SIN @unique en debtClaimId:
// permite varios intentos (rechazos) sin perder historial, a diferencia de
// como funciona hoy LegalProcess. Ver docs/schema-design-far-overdracht.md.
model CaseTransfer {
  id String @id @default(cuid())

  debtClaimId String
  debtClaim   DebtClaim @relation(fields: [debtClaimId], references: [id])

  lawyerId String?
  lawyer   Lawyer? @relation(fields: [lawyerId], references: [id])

  // Puede completarse más adelante aunque el expediente haya iniciado con
  // un abogado: representa a qué alguacil se le entrega la sentencia para
  // ejecutar una vez el abogado terminó su trabajo.
  bailiffId String?
  bailiff   Bailiff? @relation(fields: [bailiffId], references: [id])

  status CaseTransferStatus @default(PENDING_PAYMENT)

  rejectionReason String? @db.Text

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  acceptanceDeadline DateTime? // límite de 7 días para aceptar/rechazar
  respondedAt        DateTime?

  workCompletedAt DateTime? // solo camino abogado: honorarios + 5% CFSB pagados

  isEmergencyTransfer Boolean @default(false) // noodoverdracht (fallecimiento/incapacidad)
  emergencyReason     String? @db.Text

  // Poder otorgado expresamente por el participante: sin esto, el abogado o
  // el alguacil asignado solo puede negociar/registrar propuestas de
  // acuerdo de pago — el participante siempre decide (acepta, modifica o
  // rechaza). Con esto, el profesional también puede decidir por sí mismo.
  hasPowerOfAttorney       Boolean   @default(false)
  powerOfAttorneyGrantedAt DateTime?
  powerOfAttorneyNote      String?   @db.Text

  cancelledAt  DateTime?
  cancelReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lawyerFeeInvoices LawyerFeeInvoice[]
  agreements        Agreement[]
  documents         CaseTransferDocument[]

  legalProcess LegalProcess?

  // COP: cuando un Seguimiento Colectivo se transfiere a GOP, queda
  // enlazado a la CaseTransfer resultante (ver
  //                                                                             CollectiveCollection.transferredToCaseTransferId).
  collectiveCollection CollectiveCollection?

  @@index([debtClaimId])
  @@map("case_transfer")
}

// Documentos de la fase de transferencia (p.ej. el Vonnis que el abogado
// adjunta antes de transferir la ejecución al alguacil) — antes de que
// exista un LegalProcess no hay dónde adjuntarlos salvo aquí.
model CaseTransferDocument {
  id String @id @default(cuid())

  caseTransferId String
  caseTransfer   CaseTransfer @relation(fields: [caseTransferId], references: [id], onDelete: Cascade)

  fileName     String
  originalName String

  mimeType String
  size     Int

  storageKey String

  category String?

  uploadedById String?

  createdAt DateTime @default(now())

  @@index([caseTransferId])
  @@map("case_transfer_document")
}

// Ítem 1.8 del plan — mismo patrón que LawyerFeeInvoice, pero para el 5%
// del alguacil sobre la ejecución de la sentencia (GOP).
model BailiffFeeInvoice {
  id             String       @id @default(cuid())
  legalProcessId String
  legalProcess   LegalProcess @relation(fields: [legalProcessId], references: [id])

  totalAmount   Decimal   @db.Decimal(18, 2) // Monto facturado al debiteur por el alguacil
  invoiceNumber String?
  invoiceDate   DateTime?

  storageKey   String
  originalName String
  mimeType     String
  size         Int

  cfsbFeeAmount Decimal @db.Decimal(18, 2) // 5% de totalAmount

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  status    String    @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@map("bailiff_fee_invoice")
}

model LegalProcessDocument {
  id String @id @default(cuid())

  legalProcessId String

  fileName     String
  originalName String

  mimeType String

  size Int

  storageKey String

  // Texto libre: sentencia, notificación, embargo, correspondencia, acuerdo, otro.
  category String?

  uploadedById String?

  createdAt DateTime @default(now())

  legalProcess LegalProcess @relation(fields: [legalProcessId], references: [id], onDelete: Cascade)

  @@index([legalProcessId])
  @@map("legal_process_document")
}

model ClaimService {
  id String @id @default(cuid())

  debtClaimId String
  debtClaim   DebtClaim @relation(fields: [debtClaimId], references: [id])

  service ServiceType
  status  WorkflowStatus

  startedAt  DateTime
  finishedAt DateTime?

  startedById  String?
  finishedById String?

  @@map("claim_service")
}

model ClaimTimeline {
  id String @id @default(cuid())

  debtClaimId String
  debtClaim   DebtClaim @relation(fields: [debtClaimId], references: [id])

  event       TimelineEvent
  description String?
  metadata    Json?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@map("claim_timeline")
}

model ClaimCharge {
  id String @id @default(cuid())

  debtClaimId String
  debtClaim   DebtClaim @relation(fields: [debtClaimId], references: [id])

  service ServiceType
  concept String

  amount     Decimal  @db.Decimal(18, 2)
  percentage Decimal? @db.Decimal(5, 2)

  status ChargeStatus

  @@map("claim_charge")
}

model ClaimDocument {
  id String @id @default(cuid())

  debtClaimId String
  debtClaim   DebtClaim @relation(fields: [debtClaimId], references: [id])

  service ServiceType

  fileId String

  uploadedById String?
  uploadedAt   DateTime @default(now())

  @@map("claim_document")
}

// ******************************* ENUMS *******************************

enum ObligationType {
  PRINCIPAL_DEBT
  COLLECTION
  INTEREST
  LEGAL_COST
}

enum BeneficiaryType {
  PARTICIPANT
  CFSB
}

enum ObligationPayer {
  PARTICIPANT
  DEBTOR
}

enum ObligationStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ChargeStatus {
  PENDING // El cargo fue generado pero aún no es exigible o facturable.
  INVOICED // El cargo ya fue facturado al cliente.
  PAID // El cargo fue pagado.
  WAIVED // El cargo fue condonado o exonerado.
  CANCELLED // El cargo fue anulado antes de ser cobrado.
}

enum TimelineEvent {
  // =========================
  // GENERAL
  // =========================
  CLAIM_CREATED
  CLAIM_UPDATED
  CLAIM_CLOSED
  CLAIM_CANCELLED

  // =========================
  // BLC
  // =========================
  BLOCK_CHECK_PERFORMED

  // =========================
  // FAR
  // =========================
  FAR_REGISTERED
  FAR_COMPLETED

  // =========================
  // AOP
  // =========================
  AOP_STARTED
  AOP_STEP_COMPLETED
  AOP_COMPLETED

  // =========================
  // BLK
  // =========================
  BLOCKADE_REGISTERED
  BLOCKADE_RELEASED

  // =========================
  // COP
  // =========================
  COL_STARTED
  COL_DEBTOR_NOTIFIED
  COL_NETWORK_BROADCAST_SENT
  COL_EMPLOYER_FOUND
  COL_NEGOTIATION_CREATED
  COL_NEGOTIATION_ACCEPTED
  COL_NEGOTIATION_REJECTED
  COL_TRANSFERRED_TO_GOP
  COL_CLOSED
  COL_COMPLETED // se usa específicamente para el desenlace "Pagado en su totalidad"

  // =========================
  // PAYMENTS
  // =========================
  PAYMENT_REGISTERED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED

  // =========================
  // AGREEMENTS
  // =========================
  AGREEMENT_CREATED
  AGREEMENT_SIGNED
  AGREEMENT_BREACHED
  AGREEMENT_COMPLETED

  // =========================
  // GOP
  // =========================
  GOP_STARTED
  LAWYER_ASSIGNED
  BAILIFF_ASSIGNED
  VERDICT_REGISTERED
  GOP_COMPLETED

  // =========================
  // DOCUMENTS
  // =========================
  DOCUMENT_UPLOADED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED

  // =========================
  // NOTIFICATIONS
  // =========================
  NOTIFICATION_SENT
  NOTIFICATION_DELIVERED
  NOTIFICATION_FAILED

  // =========================
  // SYSTEM
  // =========================
  STATUS_CHANGED
  SERVICE_STARTED
  SERVICE_COMPLETED
}

// El GOP solo existe desde el vonnis en adelante; los estados previos
// (transferencia, aceptación, procedimiento con el abogado, cancelación
// antes de sentencia) viven en CaseTransferStatus.
enum LegalProcessStatus {
  GOP_ACTIVE // Sentencia registrada; el alguacil administra la ejecución judicial.
  GOP_INACTIVE // Sin resultados temporales; en espera de la fecha de revisión.
  CLOSED // La sentencia fue cumplida en su totalidad.
}

enum CaseTransferStatus {
  PENDING_PAYMENT // comisión de transferencia (5%) generada, esperando pago
  PENDING_ACCEPTANCE // pagado, notificado al abogado/alguacil, esperando respuesta (7 días)
  ACCEPTED // procedimiento en curso (antes IN_PROCEDURE dentro de LegalProcess)
  REJECTED
  WORK_COMPLETED // solo camino abogado: honorarios + 5% CFSB pagados, trabajo cerrado
  CANCELLED
}

enum FinancialAgreementStatus {
  PENDING_PAYMENT // registrado, esperando el pago del fee de $10
  REGISTERED // pagado — único estado estable; sin recordatorios ni monitoreo
  ESCALATED // hubo incumplimiento; se abrió un DebtClaim (AOP) a partir de este FAR
  CANCELLED
}

enum GopInactiveReason {
  NO_SEIZABLE_ASSETS
  DEBTOR_ABROAD
  NO_INCOME
  NO_ATTACHABLE_PROPERTY
  OTHER
}

enum LawyerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BailiffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum NotificationStatus {
  DRAFT // La notificación fue creada pero aún no está lista para enviarse.
  PENDING // Está lista para ser enviada cuando el sistema procese la cola.
  SCHEDULED // Tiene una fecha/hora programada para su envío.
  SENT // Fue enviada correctamente al proveedor (correo, SMS, WhatsApp, etc.).
  DELIVERED // Existe confirmación de entrega al destinatario (si el canal lo soporta).
  FAILED // El envío falló (dirección inválida, error del proveedor, etc.).
  CANCELLED // Se canceló antes de enviarse.
}

enum CollectiveCollectionStatus {
  PENDING_PAYMENT // Registrado, esperando la confirmación del pago del 5% de inicio de COP — no está activo todavía.
  ACTIVE // COP Activo — recién iniciado, o el participante decidió mantenerlo activo tras un caso sin respuesta.
  AWAITING_DEBTOR_RESPONSE // En espera de respuesta del deudor.
  PAYMENT_AGREEMENT_REQUESTED // Acuerdo de pago solicitado — hay una COLNegotiation OPEN pendiente de decisión.
  PAYMENT_AGREEMENT_ACCEPTED // Acuerdo de pago aceptado (terminal) — el COP finaliza aquí.
  PAID_IN_FULL // Pagado en su totalidad (terminal).
  TRANSFERRED // Transferido a GOP (terminal).
  CLOSED // Cerrado (terminal) — el participante desistió sin acuerdo ni transferencia.
}

enum AdministrativeCollectionStatus {
  DRAFT // Creado pero aún no iniciado
  ACTIVE // El proceso administrativo está en ejecución
  WAITING_RESPONSE // Esperando respuesta del deudor
  PAID // La deuda fue pagada durante AOP
  DEFAULTED // Se declaró el incumplimiento
  BLOCKADE_CREATED // Se registró el BLK correctamente
  CANCELLED // Cancelado por el acreedor
  CLOSED // Finalizado
}

enum ServiceType {
  FAR
  AOP
  BLK
  BLC
  COP
  GOP
}

enum DebtClaimOrigin {
  FAR
  MANUAL
  IMPORT
  API
  BLK
}

enum DebtClaimStatus {
  OPEN
  IN_PROGRESS
  SETTLED
  CLOSED
  CANCELLED
}

enum BlockadeStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum AOPStep {
  REMINDER
  FINAL_NOTICE
  DEFAULT_NOTICE
  BLK_NOTIFICATION
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationRecipient {
  DEBTOR
  EMPLOYER
  MEMBER
  CLIENT
}

enum NotificationChannel {
  EMAIL
  SMS
  LETTER
  WHATSAPP
  IN_APP // COP: fila de auditoría de una notificación in-app (COLNotification), sin despacho real por este canal.
}

enum NegotiationStatus {
  OPEN
  ACCEPTED
  REJECTED
  EXPIRED
}

enum COLNegotiationSubmitter {
  DEBTOR
  EMPLOYER
}

enum COLNetworkQueryStatus {
  OPEN
  MATCHED
  CLOSED_NO_MATCH
}

enum COLNetworkAnswer {
  YES
  NO
}

