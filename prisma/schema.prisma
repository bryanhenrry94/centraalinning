  @@index([user_id, is_read])
  @@index([tenant_id])
  @@map("notification")
}

// CFSB — Ayuda y Soporte: mensajería simple y directa entre un usuario y
// CFSB (Sugerencia/Queja/Problema técnico). No es un sistema de tickets ni de
// mediación de disputas entre partes — quejas sobre un participante, abogado
// o alguacil se presentan directamente ante esa parte, no acá.
enum SupportMessageType {
  SUGGESTION
  COMPLAINT
  TECHNICAL_ISSUE
}

enum SupportMessageStatus {
  RECEIVED
  IN_PROGRESS
  ANSWERED
  CLOSED
}

model SupportMessage {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdById String
  createdBy   User   @relation("SupportMessageCreatedBy", fields: [createdById], references: [id])

  type          SupportMessageType
  subject       String
  caseReference String?
  message       String             @db.Text

  // Snapshot automático al momento del envío — no depende de que el
  // User/rol/Person cambien después.
  senderName       String
  senderEmail      String
  senderRole       String
  senderCfsbNumber String?

  originalName String?
  storageKey   String?
  mimeType     String?
  size         Int?

  status SupportMessageStatus @default(RECEIVED)

  response      String?   @db.Text
  respondedById String?
  respondedBy   User?     @relation("SupportMessageRespondedBy", fields: [respondedById], references: [id])
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([createdById])
  @@index([status])
  @@map("support_message")
}

enum ContractStatus {
  DRAFT
  REGISTERED
}

enum ContractPartyRole {
  PARTY_A
  PARTY_B
