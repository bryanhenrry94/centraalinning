NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=

ADMIN_TENANT_ID=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SENDER_NAME=
DEV_EMAIL_REDIRECT=
OWNER_EMAIL_ADDRESS=